rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId);
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId) 
        && request.resource.data.customerName is string 
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 200;
      allow update, delete: if isValidId(orderId);
    }

    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isValidId(settingsId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
